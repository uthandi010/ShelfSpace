<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ShelfSpace.App.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ShelfSpace.App.Core.ViewModels;assembly=ShelfSpace.App.Core"
    x:DataType="vm:RegisterViewModel"
    Title="Create account">
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="14" MaximumWidthRequest="360" HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="Create your ShelfSpace account" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Entry Placeholder="Name" Text="{Binding Name}" />
            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
            <Entry Placeholder="Password (at least 8 characters)" Text="{Binding Password}" IsPassword="True" />

            <Button Text="Create account" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
