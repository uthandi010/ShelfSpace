<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ShelfSpace.App.Pages.NewOrderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ShelfSpace.App.Core.Models;assembly=ShelfSpace.App.Core"
    xmlns:vm="clr-namespace:ShelfSpace.App.Core.ViewModels;assembly=ShelfSpace.App.Core"
    x:DataType="vm:NewOrderViewModel"
    Title="New order">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Close" Clicked="OnCloseClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Entry Placeholder="Customer name" Text="{Binding CustomerName}" />

            <Frame Padding="14" BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Add a line item" FontAttributes="Bold" />
                    <Picker Title="Choose a product" ItemsSource="{Binding AvailableProducts}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedProduct}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Placeholder="Quantity" Text="{Binding QuantityText}" Keyboard="Numeric" />
                        <Button Grid.Column="1" Text="Add" Command="{Binding AddLineCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <CollectionView ItemsSource="{Binding Lines}" HeightRequest="200">
                <CollectionView.EmptyView>
                    <Label Text="No line items yet." TextColor="Gray" Margin="0,10,0,0" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderLineDraft">
                        <Grid Padding="0,6" ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Quantity}" />
                                        <Span Text=" × " />
                                        <Span Text="{Binding Product.Name}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Column="1" Text="{Binding LineTotal, StringFormat='{0:C}'}" VerticalOptions="Center" Margin="0,0,10,0" />
                            <Button Grid.Column="2" Text="Remove" Clicked="OnRemoveLineClicked" CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label FontAttributes="Bold" FontSize="18">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Total: " />
                        <Span Text="{Binding TotalPreview, StringFormat='{0:C}'}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Button Text="Place order" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
